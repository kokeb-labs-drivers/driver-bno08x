 * configure_file() writes it here.
 */
#ifndef BNO08X_VERSION_H
#define BNO08X_VERSION_H

/** Major version: incompatible API changes. */
#define BNO08X_VERSION_MAJOR @BNO08X_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define BNO08X_VERSION_MINOR @BNO08X_VERSION_MINOR@
/** Patch version: fixes. */
#define BNO08X_VERSION_PATCH @BNO08X_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define BNO08X_VERSION_STRING "@BNO08X_VERSION@"

#endif // BNO08X_VERSION_H
